POSTGRES_DB=lawrag
POSTGRES_USER=lawrag
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://lawrag:change-me@postgres:5432/lawrag
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio
MINIO_BUCKET=legal-sources
JWT_SECRET=abc@zxcvbnm
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=abc@123
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=Qwen3.5:2b
# Shared temperature for answer generation, contextualization, HyDE/MultiQuery,
# memory summary, Map-Reduce, and the warm-up request.
LLM_TEMPERATURE=0.1
CONFIDENCE_THRESHOLD=0.50
CONVERSATION_CONFIDENCE_THRESHOLD=0.30
# Keep candidates at or above the percentile of their own reranker-score batch.
# 70 retains the top roughly 30%; contextual follow-ups use a wider top 40%.
RERANK_SCORE_PERCENTILE=70
CONVERSATION_RERANK_SCORE_PERCENTILE=60
# Hybrid RAG always runs first. Web search only runs after an empty or
# low-score rerank result. Add your own tool endpoint/key below; the expected
# adapter contract is documented in backend/app/services/web_search.py.
WEB_SEARCH_FALLBACK_ENABLED=true
WEB_SEARCH_RAG_THRESHOLD=0.20
WEB_SEARCH_API_URL=https://api.tavily.com/search
WEB_SEARCH_API_KEY=tvly-YOUR-KEY-HERE
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_TIMEOUT_SECONDS=15
WEB_SEARCH_MAX_RESULTS=5
CLAIM_SUPPORT_THRESHOLD=0.65
EXTRACTIVE_FALLBACK_THRESHOLD=0.50
INDEX_BATCH_SIZE=32
# Legal structure-aware chunking: a normal Điều/Khoản/Điểm stays whole.
# Only an oversized unit is split by sentence/paragraph with limited overlap.
CHUNK_MAX_TOKENS=450
CHUNK_SPLIT_OVERLAP_TOKENS=40
CHUNK_AUDIT_SAMPLE_SIZE=5
# Development/local automatically logs top-k retrieval candidates. In
# production set APP_ENV=production (logs off), or override explicitly below.
APP_ENV=development
# RETRIEVAL_DEBUG_LOGS=true
RETRIEVAL_DEBUG_TOP_K=8
# Token estimator uses max(2 tokens/syllable-like word, len/2.5) and only
# spends 85% of model context to absorb tokenizer/model differences.
CONTEXT_BUDGET_SAFETY_MARGIN=0.85
CONVERSATION_CONTEXT_MESSAGES=6
CONVERSATION_CONTEXT_MAX_CHARS=3000
CONTEXTUALIZE_RETRIEVAL_WITH_LLM=true
CONTEXTUALIZE_TIMEOUT_SECONDS=30
# A clear switch, for example commercial → labour, starts retrieval from the
# current question rather than forcing prior conversation context onto it.
INTENT_SHIFT_DETECTION_ENABLED=true
RETRIEVAL_AUGMENTATION_ENABLED=true
# Empty means reuse OLLAMA_MODEL. Set a compact model here after role-based routing is added.
RETRIEVAL_AUGMENTATION_MODEL=
RETRIEVAL_AUGMENTATION_TIMEOUT_SECONDS=30
# Ask the user to split an explicitly mixed question (for example labour law
# plus enterprise governance) before HyDE/MultiQuery expands retrieval.
MIXED_DOMAIN_CLARIFICATION_ENABLED=true
# Keep all grounded sources usable when they exceed the model context. Set to
# false only for constrained/offline deployments (then the fitted subset is used).
MAP_REDUCE_ENABLED=true
WARM_MODELS_ON_STARTUP=true
PUBLIC_RATE_LIMIT_PER_MINUTE=20
# Distributed Redis limiter: covers all API instances. If Redis is down, the
# API logs a warning and temporarily falls back to a per-instance limiter.
RATE_LIMIT_REDIS_ENABLED=true
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=8
