POSTGRES_DB=lawrag
POSTGRES_USER=lawrag
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://lawrag:change-me@postgres:5432/lawrag
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio
MINIO_BUCKET=legal-sources
JWT_SECRET=abc@zxcvbnm
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=abc@123
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=Qwen3.5:2b
CONFIDENCE_THRESHOLD=0.50
CONVERSATION_CONFIDENCE_THRESHOLD=0.30
# Keep candidates at or above the percentile of their own reranker-score batch.
# 70 retains the top roughly 30%; contextual follow-ups use a wider top 40%.
RERANK_SCORE_PERCENTILE=70
CONVERSATION_RERANK_SCORE_PERCENTILE=60
CLAIM_SUPPORT_THRESHOLD=0.65
EXTRACTIVE_FALLBACK_THRESHOLD=0.50
INDEX_BATCH_SIZE=32
RETRIEVAL_DEBUG_LOGS=true
RETRIEVAL_DEBUG_TOP_K=8
CONVERSATION_CONTEXT_MESSAGES=6
CONVERSATION_CONTEXT_MAX_CHARS=3000
CONTEXTUALIZE_RETRIEVAL_WITH_LLM=true
CONTEXTUALIZE_TIMEOUT_SECONDS=30
RETRIEVAL_AUGMENTATION_ENABLED=true
# Empty means reuse OLLAMA_MODEL. Set a compact model here after role-based routing is added.
RETRIEVAL_AUGMENTATION_MODEL=
RETRIEVAL_AUGMENTATION_TIMEOUT_SECONDS=30
WARM_MODELS_ON_STARTUP=true
PUBLIC_RATE_LIMIT_PER_MINUTE=20
